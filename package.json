{
  "name": "attendance-maker",
  "version": "1.0.0",
  "description": "Attendance monitoring app",
  "main": "main.cjs",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"vite\" \"electron .\"",
    "build": "tsc && vite build",
    "electron:start": "electron .",
    "dist": "vite build && electron-builder"
  },
  "dependencies": {
    "date-fns": "^3.6.0",
    "exceljs": "^4.4.0",
    "lucide-react": "^0.368.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.5.0",
    "concurrently": "^10.0.3",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "postcss": "^8.5.15",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.2.2",
    "vite": "^5.2.0"
  },
  "build": {
    "appId": "com.attendance.maker",
    "win": {
      "target": "nsis"
    },
    "directories": {
      "output": "release"
    }
  }
}
